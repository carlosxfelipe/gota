meta {
  name: Create Order
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/api/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:json {
  {
    "customerName": "Carlos Felipe",
    "shippingAddress": {
      "street": "Av. Paulista, 1000",
      "city": "São Paulo",
      "zipCode": "01310100"
    }
  }
}

script:post-response {
  if (res.status === 200 && res.body.orderId) {
    bru.setVar("orderId", res.body.orderId);
  }
}
