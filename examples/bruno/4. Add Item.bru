meta {
  name: Add Item
  type: http
  seq: 4
}

post {
  url: http://localhost:3000/api/orders/{{orderId}}/items
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:json {
  {
    "ProductName": "Coca-Cola Can 350ml",
    "Price": 5.50,
    "Quantity": 2
  }
}

script:post-response {
  if (res.status === 200 && res.body.itemId) {
    bru.setVar("itemId", res.body.itemId);
  }
}
